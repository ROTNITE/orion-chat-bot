# Obtain from @BotFather. Never commit your actual token.
BOT_TOKEN=replace-with-botfather-token
# Optional: your numeric Telegram ID; grants access only to /health.
OWNER_ID=0
DB_PATH=./data/orion.sqlite3
LOG_LEVEL=INFO
# Optional proxy: http://host:port, socks4://host:port or socks5://host:port
TELEGRAM_PROXY=
# Direct connections only. Set to 1 if IPv6 routing is broken on this PC/network.
FORCE_IPV4=0
# Telegram HTTP request timeout, seconds.
TELEGRAM_TIMEOUT=60
